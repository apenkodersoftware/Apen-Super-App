root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 2
max_line_length = 140
ktlint_code_style = ktlint_official
# Compose functions are PascalCase by convention (e.g. `@Composable fun POSScreen(...)`),
# which otherwise violates ktlint's standard lowerCamelCase function-naming rule.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{xml,json,yml,yaml}]
indent_style = space
indent_size = 2
